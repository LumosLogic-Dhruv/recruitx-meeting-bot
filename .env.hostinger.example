# ── Server URLs (update these two — everything else stays the same) ────────────
SERVER_URL=https://meet.recruitx-ai.com
FRONTEND_URL=https://meet.recruitx-ai.com

# ── Recall.ai ─────────────────────────────────────────────────────────────────
RECALL_API_KEY=your_recall_api_key
RECALL_API_URL=https://us-east-1.recall.ai/api/v1

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EVAL_MODEL=gpt-4o
OPENAI_SCORECARD_MODEL=gpt-4o
OPENAI_PROMPT_MODEL=gpt-4o

# ── ElevenLabs ────────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=SNr51KAoFWjq7b0L9cRb
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# ── Convex (unchanged — cloud hosted) ─────────────────────────────────────────
CONVEX_URL=https://festive-kingfisher-814.eu-west-1.convex.cloud

# ── Cloudinary (permanent video storage) ──────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_REDIRECT_URI is auto-built from SERVER_URL — leave this unset unless overriding

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret-key

# ── SMTP ──────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your_gmail_app_password

# ── Branding ──────────────────────────────────────────────────────────────────
COMPANY_NAME=LumosLogic

# ── Deepgram (optional) ───────────────────────────────────────────────────────
# DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_MODEL=nova-3
