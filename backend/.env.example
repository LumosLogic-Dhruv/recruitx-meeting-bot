RECALL_API_KEY=your_recall_api_key
RECALL_API_URL=https://ap-northeast-1.recall.ai/api/v1
OPENAI_API_KEY=your_openai_api_key
SERVER_URL=https://meet.recruitx-ai.com
FRONTEND_URL=https://meet.recruitx-ai.com

# Optional — pass your Deepgram key here, or configure it in the Recall.ai dashboard
DEEPGRAM_API_KEY=your_deepgram_api_key

# Model Configurations
DEEPGRAM_MODEL=nova-3
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
OPENAI_MODEL=gpt-4o-mini
OPENAI_EVAL_MODEL=gpt-4o
OPENAI_SCORECARD_MODEL=gpt-4o

# ── Cloudinary (permanent video storage — Recall URLs expire after 24h) ───────
CLOUDINARY_CLOUD_NAME=iqchrpsj
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Recall.ai Google Meet bot login (OPTIONAL — leave unset for anonymous bot) ─
# Only set this if you have completed the full Google Workspace SSO setup in
# Recall.ai's dashboard. If unset, the bot joins anonymously and the Google Meet
# space is automatically set to OPEN access (no waiting room) via the Meet v2 API.
# RECALL_GOOGLE_LOGIN_GROUP_ID=your_login_group_id

# ── Google Calendar (for meeting link generation) ─────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
COMPANY_NAME=LumosLogic                         # shown in email subject and body

# ── SMTP (for sending interview invite emails to candidates) ──────────────────
# Use a Gmail account with an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your_gmail_app_password
